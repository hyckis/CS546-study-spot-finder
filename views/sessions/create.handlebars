<main>
  <h1>Create Study Session</h1>

  <form id="createForm">
    <input type="text" id="creatorId" placeholder="creatorId"><br>
    <input type="text" id="spotId" placeholder="spotId"><br>
    <input type="text" id="course" placeholder="course"><br>
    <input type="text" id="topic" placeholder="topic"><br>
    <input type="text" id="sessionTime" placeholder="YYYY-MM-DDTHH:mm:ss"><br>
    <input type="number" id="groupSize" placeholder="group size"><br>
    <button type="submit">Create</button>
  </form>

  <p id="createResult"></p>

  <a href="/sessions/search">Go to Search</a>

  <script src="/public/js/create.js"></script>
</main>