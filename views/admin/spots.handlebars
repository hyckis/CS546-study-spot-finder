<h2>Admin - Study Spots</h2>
<p><a class="button" href="/admin/spots/new">Create New Spot</a> <a class="button secondary" href="/admin/spots/suggestions/review">Review Suggestions</a></p>
{{#if spots.length}}
  <table>
    <thead><tr><th>Name</th><th>Category</th><th>City</th><th>Status</th><th>Actions</th></tr></thead>
    <tbody>
      {{#each spots}}
        <tr>
          <td><a href="/spots/{{_id}}">{{name}}</a></td>
          <td>{{category}}</td>
          <td>{{boroughOrCity}}</td>
          <td>{{openStatus}}</td>
          <td>
            <a href="/admin/spots/{{_id}}/edit">Edit</a>
            <form method="POST" action="/admin/spots/{{_id}}/delete" class="inline-form"><button type="submit">Delete</button></form>
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
{{else}}
  <p>No study spots yet. Run <code>npm run seed:spots</code> or create one manually.</p>
{{/if}}
