<h1>Admin Study Spots</h1>
<p>Manage official study spot records imported from datasets, added manually by admin, or approved from user suggestions.</p>
<p>
  <a class="button" href="/admin/spots/new">Create New Study Spot</a>
  <a class="button secondary" href="/admin/spots/suggestions/review">Review Suggestions</a>
</p>

{{#if spots.length}}
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Category</th>
        <th>City</th>
        <th>Source</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {{#each spots}}
        <tr>
          <td>{{this.name}}</td>
          <td>{{this.category}}</td>
          <td>{{this.boroughOrCity}}</td>
          <td>{{this.sourceType}}</td>
          <td>{{this.openStatus}}</td>
          <td>
            <a href="/spots/{{this._id}}">View</a> |
            <a href="/admin/spots/{{this._id}}/edit">Edit</a>
            <form method="POST" action="/admin/spots/{{this._id}}/delete" class="inline-form" onsubmit="return confirm('Delete this study spot?');">
              <button type="submit" class="link-button">Delete</button>
            </form>
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
{{else}}
  <p>No study spots have been added yet.</p>
{{/if}}
