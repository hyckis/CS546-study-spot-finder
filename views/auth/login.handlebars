<section class="form-card auth-card">
  <h1>Login</h1>
  <p class="muted">Log in to submit study spot suggestions or access admin features.</p>

  {{#if error}}
    <p class="error-message">{{error}}</p>
  {{/if}}

  <form method="POST" action="/auth/login" class="stacked-form">
    <label for="email">Email</label>
    <input id="email" name="email" type="email" required placeholder="admin@spotscouter.com">

    <label for="password">Password</label>
    <input id="password" name="password" type="password" required placeholder="Password">

    <button type="submit" class="primary-button">Login</button>
  </form>

  <p class="muted auth-hint">
    Seed test accounts:<br>
    Admin: admin@spotscouter.com / Admin123!<br>
    Student: student@spotscouter.com / Student123!
  </p>

  <p>Need an account? <a href="/auth/signup">Sign up</a></p>
</section>
