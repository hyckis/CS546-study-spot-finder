<section class="form-card auth-card">
  <h1>Sign Up</h1>
  <p class="muted">Create an account to suggest study spots.</p>

  {{#if error}}
    <p class="error-message">{{error}}</p>
  {{/if}}

  <form method="POST" action="/auth/signup" class="stacked-form">
    <label for="username">Username</label>
    <input id="username" name="username" type="text" required placeholder="wanli">

    <label for="email">Email</label>
    <input id="email" name="email" type="email" required placeholder="you@example.com">

    <label for="password">Password</label>
    <input id="password" name="password" type="password" required placeholder="Password">

    <button type="submit" class="primary-button">Sign Up</button>
  </form>

  <p>Already have an account? <a href="/auth/login">Login</a></p>
</section>
