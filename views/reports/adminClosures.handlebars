{{#if closureReports.length}}
  {{#each closureReports}}
    <article class="card">
      <h3>Closure Report <span class="badge">{{status}}</span></h3>

      <p><strong>Spot ID:</strong> {{spotId}}</p>
      <p><strong>Submitted by:</strong> {{userId}}</p>
      <p><strong>Created at:</strong> {{createdAt}}</p>

      {{#if resolvedBy}}
        <p><strong>Resolved by:</strong> {{resolvedBy}}</p>
      {{/if}}

      {{#if resolvedAt}}
        <p><strong>Resolved at:</strong> {{resolvedAt}}</p>
      {{/if}}

      {{#if isPending}}
        <form method="POST" action="/reports/admin/closures/{{_id}}/resolve" class="review-form">
          <input type="hidden" name="status" value="approved">
          <button type="submit">Approve</button>
        </form>

        <form method="POST" action="/reports/admin/closures/{{_id}}/resolve" class="review-form">
          <input type="hidden" name="status" value="rejected">
          <button type="submit">Deny</button>
        </form>
      {{/if}}
    </article>
  {{/each}}
{{else}}
  <p>No closure reports submitted yet.</p>
{{/if}}