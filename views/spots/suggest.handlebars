<h1>Suggest a Study Spot</h1>
<p>Submit a study spot for admin review. Approved suggestions will be added to the official study spot list.</p>

{{#if error}}<p class="error">{{error}}</p>{{/if}}

<form method="POST" action="/spots/suggest" class="form-card">
  <label>Name <input type="text" name="name" value="{{form.name}}" required></label>
  <label>Category
    <select name="category" required>
      <option value="Library">Library</option>
      <option value="Cafe">Cafe</option>
      <option value="Campus">Campus</option>
      <option value="Other">Other</option>
    </select>
  </label>
  <label>Address <input type="text" name="address" value="{{form.address}}" required></label>
  <label>City / Borough <input type="text" name="boroughOrCity" value="{{form.boroughOrCity}}" required></label>
  <label>State <input type="text" name="state" value="{{form.state}}" maxlength="2" required></label>
  <label>ZIP Code <input type="text" name="zipCode" value="{{form.zipCode}}" required></label>
  <label>Latitude <input type="number" step="any" name="latitude" value="{{form.latitude}}" required></label>
  <label>Longitude <input type="number" step="any" name="longitude" value="{{form.longitude}}" required></label>
  <label>Open Status
    <select name="openStatus">
      <option value="Unknown">Unknown</option>
      <option value="Open">Open</option>
      <option value="Closed">Closed</option>
    </select>
  </label>
  <label class="checkbox-label"><input type="checkbox" name="wifiAvailable"> WiFi Available</label>
  <label class="checkbox-label"><input type="checkbox" name="outletsAvailable"> Outlets Available</label>
  <label>Description <textarea name="description" required>{{form.description}}</textarea></label>
  <button type="submit">Submit Suggestion</button>
</form>
