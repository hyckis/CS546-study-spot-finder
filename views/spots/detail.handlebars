<article class="detail-card">
  <h1>{{spot.name}}</h1>
  <p><strong>Category:</strong> {{spot.category}}</p>
  <p><strong>Address:</strong> {{spot.address}}, {{spot.boroughOrCity}}, {{spot.state}} {{spot.zipCode}}</p>
  <p><strong>Description:</strong> {{spot.description}}</p>

  <h2>Availability Information</h2>
  <ul>
    <li>WiFi: {{#if spot.wifiAvailable}}Available{{else}}Not listed{{/if}}</li>
    <li>Outlets: {{#if spot.outletsAvailable}}Available{{else}}Not listed{{/if}}</li>
    <li>Open Status: {{spot.openStatus}}</li>
    <li>Average Rating: {{spot.averageRating}}</li>
  </ul>

  <h2>Location Data</h2>
  <ul>
    <li>Latitude: {{spot.coordinates.latitude}}</li>
    <li>Longitude: {{spot.coordinates.longitude}}</li>
    <li>Source: {{spot.sourceType}}</li>
  </ul>

  <section class="map-section">
    <h2>Map View</h2>
    {{#if hasMap}}
      <p>This map shows the selected study spot based on the latitude and longitude stored in the studySpots collection.</p>
      <iframe
        class="spot-map"
        title="Map location for {{spot.name}}"
        src="{{mapEmbedUrl}}">
      </iframe>
      <p><a href="{{mapOpenUrl}}" target="_blank" rel="noopener noreferrer">Open larger map</a></p>
    {{else}}
      <p>Map view is not available because this study spot does not have valid coordinates.</p>
    {{/if}}
  </section>

  <section class="note-box">
    <h2>Reviews and Real-Time Reports</h2>
    <p>This section is prepared for the Reporting and Review System. Reviews, WiFi reports, socket reports, and crowdedness reports can be connected here by Part 3.</p>
  </section>

  <p><a href="/spots">Back to Study Spots</a></p>
</article>
