<article class="detail-card">
  <h2>{{spot.name}}</h2>
  <p><strong>Category:</strong> {{spot.category}}</p>
  <p><strong>Address:</strong> {{spot.address}}, {{spot.boroughOrCity}}, {{spot.state}} {{spot.zipCode}}</p>
  <p><strong>Description:</strong> {{spot.description}}</p>
  <p><strong>Average Rating:</strong> {{spot.averageRating}} / 5</p>
  <p><strong>WiFi Available:</strong> {{#if spot.wifiAvailable}}Yes{{else}}No{{/if}}</p>
  <p><strong>Outlets Available:</strong> {{#if spot.outletsAvailable}}Yes{{else}}No{{/if}}</p>
  <p><strong>Open Status:</strong> {{spot.openStatus}}</p>
  <p><strong>Source:</strong> {{spot.sourceType}}</p>
  <p><strong>Coordinates:</strong> {{spot.coordinates.latitude}}, {{spot.coordinates.longitude}}</p>
</article>

<section class="card map-card">
  <h3>Map View</h3>
  {{#if mapEmbedUrl}}
    <iframe
      class="spot-map"
      title="Map location for {{spot.name}}"
      src="{{mapEmbedUrl}}"
      loading="lazy">
    </iframe>
    <p class="map-note">Map is based on this spot's saved latitude and longitude.</p>
  {{else}}
    <p>Map is not available because this spot does not have valid coordinates.</p>
  {{/if}}
</section>


{{#if isAdmin}}
  <p>
    <a class="button" href="/admin/spots/{{spot._id}}/edit">Edit This Spot</a>
  </p>
{{/if}}

<section class="card">
  <h3>Current Study Conditions</h3>

  {{#if reportSummary}}
    <p><strong>Reports Count:</strong> {{reportSummary.reportCount}}</p>
    <p><strong>WiFi:</strong> {{reportSummary.wifiStatus}}</p>
    <p><strong>Outlets:</strong> {{reportSummary.socketStatus}}</p>
    <p><strong>Crowdedness:</strong> {{reportSummary.crowdednessStatus}}</p>
  {{else}}
    <p>No reports yet.</p>
  {{/if}}
</section>

<section class="card">
  <h3>Submit Real-Time Report</h3>

  <form method="POST" action="/reports/spots/{{spot._id}}/status">
    <label>
      WiFi
      <select name="wifiStatus" required>
        <option value="Fast">Fast</option>
        <option value="Moderately Fast">Moderately Fast</option>
        <option value="Slow">Slow</option>
      </select>
    </label>

    <label>
      Outlets
      <select name="socketStatus" required>
        <option value="Enough">Enough</option>
        <option value="Moderately Enough">Moderately Enough</option>
        <option value="Full">Full</option>
      </select>
    </label>

    <label>
      Crowdedness
      <select name="crowdednessStatus" required>
        <option value="Quiet">Quiet</option>
        <option value="Moderately Busy">Moderately Busy</option>
        <option value="Crowded">Crowded</option>
        <option value="Full">Full</option>
      </select>
    </label>

    <button type="submit">Submit Report</button>
  </form>
</section>

<section class="card">
  <h3>Recent Reports</h3>

  {{#if hasActiveReports}}
    <ul>
      {{#each activeReports}}
        <li>
          WiFi: {{wifiStatus}},
          Outlets: {{socketStatus}},
          Crowd: {{crowdednessStatus}}
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p>No active reports.</p>
  {{/if}}
</section>

<section class="card">
  <h3>Report Spot Closure</h3>
  <p>If this study spot is closed or unavailable, submit a closure report for admin review.</p>

  <form method="POST" action="/reports/spots/{{spot._id}}/closure">
    <button type="submit">Report as Closed</button>
  </form>
</section>

{{#if reviewSuccess}}
  <section class="card">
    <p>Closure report submitted successfully.</p>
  </section>
{{/if}}


<section class="card">
  <h3>Leave a Review</h3>

  <form method="POST" action="/reviews/spots/{{spot._id}}">
    <label>
      Rating
      <select name="rating" required>
        <option value="5">5</option>
        <option value="4">4</option>
        <option value="3">3</option>
        <option value="2">2</option>
        <option value="1">1</option>
      </select>
    </label>

    <label>
      Comment
      <textarea name="comment" required></textarea>
    </label>

    <button type="submit">Submit Review</button>
  </form>
</section>

<section class="card">
  <h3>Reviews</h3>

  {{#if hasReviews}}
    <ul>
      {{#each reviews}}
        <li>
          ☆ {{rating}} — {{comment}} 
          <strong>By:</strong> {{username}}
          {{#if isOwner}}
            <form method="POST" action="/reviews/{{_id}}/update">
              <label>
                Rating
                <select name="rating" required>
                  <option value="5">5</option>
                  <option value="4">4</option>
                  <option value="3">3</option>
                  <option value="2">2</option>
                  <option value="1">1</option>
                </select>
              </label>

              <label>
                Comment
                <textarea name="comment" required>{{comment}}</textarea>
              </label>

              <button type="submit">Update Review</button>
            </form>

            <form method="POST" action="/reviews/{{_id}}/delete">
              <button type="submit">Delete Review</button>
            </form>
          {{/if}}
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p>No reviews yet.</p>
  {{/if}}
</section>

<p><a href="/spots">Back to study spots</a></p>
